{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{- range .Site.AllPages }}
  {{- if and (ne .Type "footer") (ne .Type "search") (ne .Params.noindex true) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if .Lastmod }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
    {{- else }}
    <lastmod>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
    {{- end }}
    {{- if .Params.priority }}
    <priority>{{ .Params.priority }}</priority>
    {{- else if .IsHome }}
    <priority>1.0</priority>
    {{- else if eq .Type "blog" }}
    <priority>0.8</priority>
    {{- else }}
    <priority>0.7</priority>
    {{- end }}
    {{- if .Params.changefreq }}
    <changefreq>{{ .Params.changefreq }}</changefreq>
    {{- else if .IsHome }}
    <changefreq>weekly</changefreq>
    {{- else if eq .Type "blog" }}
    <changefreq>monthly</changefreq>
    {{- else }}
    <changefreq>yearly</changefreq>
    {{- end }}
    {{- if .Params.image }}
    <image:image>
      <image:loc>{{ .Params.image | absURL }}</image:loc>
      {{- if .Params.imageAlt }}
      <image:title>{{ .Params.imageAlt }}</image:title>
      {{- else }}
      <image:title>{{ .Title }}</image:title>
      {{- end }}
    </image:image>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
